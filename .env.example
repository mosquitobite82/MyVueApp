# Shared environment (workspace root). Copy to .env and adjust.
# Frontend (my-vue-app) and backend (MyBackendApp) both read from here.

# Backend base URL (used by frontend for API and SignalR).
VITE_API_URL=http://localhost:5215

# Backend listen URL (ASP.NET Core).
ASPNETCORE_URLS=http://localhost:5215

# CORS allowed origins (comma-separated). Backend uses this in development.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
